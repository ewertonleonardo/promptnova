    "@mdx-js/react": "^2.1.5",
    "@sindresorhus/slugify": "^2.1.1",
    "@tailwindcss/typography": "^0.5.8",
    "acorn": "^8.8.1",
    "algoliasearch": "^4.14.2",
    "clsx": "^1.2.0",
    "electron-store": "^8.1.0",
    "focus-visible": "^5.2.0",
    "framer-motion": "7.8.1",
    "mdast-util-to-string": "^3.1.0",
    "mdx-annotations": "^0.1.0",
    "react": "^18.2.0",
