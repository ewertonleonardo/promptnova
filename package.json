{
  "name": "promptnova",
  "version": "0.0.0",
  "description": "A desktop application for centralized prompt management and utilization",
  "main": "./dist/main/index.js",
  "private": true,
  "author": {
    "name": "PromptNova Team"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config build/webpack.config.js",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "cross-env NODE_ENV=production webpack --config build/webpack.config.js",
    "build:electron": "electron-builder build --config build/electron-builder.yml",
    "start": "electron .",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src --fix",
    "test": "jest"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
